# Flarum 2.0.2 (flarum/core v2.0.2) on Railway.
# Base: crazymax/flarum, the widely used Flarum image (Flarum publishes no image of its own),
# pinned by version and multi-arch digest. Bump both together and add a CHANGELOG.md entry.
FROM crazymax/flarum:2.0.2@sha256:cff0216da14932588bf63956c4d3633777e7dc21956a07d1a8f0682efcf8df63

# The image creates the first admin as flarum/flarum. Use FLARUM_ADMIN_* instead (password
# generated by the template), and fail the build if the upstream script ever changes shape.
RUN set -eu; f=/etc/s6-overlay/scripts/config; \
    sed -i \
      -e 's|^  username: flarum$|  username: "${FLARUM_ADMIN_USER}"|' \
      -e 's|^  password: flarum$|  password: "${FLARUM_ADMIN_PASSWORD}"|' \
      -e 's|^  password_confirmation: flarum$|  password_confirmation: "${FLARUM_ADMIN_PASSWORD}"|' \
      -e 's|^  email: flarum@flarum.docker$|  email: "${FLARUM_ADMIN_EMAIL}"|' \
      -e 's|^  forum_title: ${FLARUM_FORUM_TITLE}$|  forum_title: "${FLARUM_FORUM_TITLE}"|' \
      -e 's|>> WARNING: Flarum has been installed with the default credentials (flarum/flarum)|>> Flarum installed. Admin user: ${FLARUM_ADMIN_USER} (password: the FLARUM_ADMIN_PASSWORD variable)|' \
      -e 's|>> Please connect to ${FLARUM_BASE_URL} and change them!|>> Forum: ${FLARUM_BASE_URL}|' \
      "$f"; \
    test "$(grep -c 'FLARUM_ADMIN_' "$f")" -ge 5; \
    ! grep -qE 'password: flarum|flarum@flarum.docker' "$f"

COPY rootfs /

# Railway sets PORT; nginx listens on it (8000 when unset).
ENV PORT=8000 \
    DB_TIMEOUT=300 \
    REAL_IP_FROM=0.0.0.0/0 \
    UPLOAD_MAX_SIZE=32M \
    NGINX_WORKER_PROCESSES=2

EXPOSE 8000
VOLUME [ "/data" ]
ENTRYPOINT [ "/init" ]
